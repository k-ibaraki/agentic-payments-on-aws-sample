{
  "name": "agent-app",
  "version": "0.1.0",
  "type": "module",
  "blocksTemplate": "auth-cognito",
  "blocksTemplateDescription": "Vite + vanilla-DOM frontend with Cognito passwordless email-OTP auth end-to-end",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "aws-blocks"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "spec": "blocks-generate-spec",
    "dev:server": "cross-env BUYER_SELF_SIGNUP=true tsx watch aws-blocks/scripts/server.ts",
    "dev": "cross-env BUYER_SELF_SIGNUP=true tsx watch aws-blocks/scripts/server.ts",
    "sandbox": "tsx aws-blocks/scripts/sandbox.ts",
    "sandbox:destroy": "tsx -C cdk aws-blocks/scripts/sandbox-destroy.ts",
    "sandbox:console": "tsx aws-blocks/scripts/console.ts",
    "cleanup": "tsx aws-blocks/scripts/cleanup.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "tsx aws-blocks/scripts/deploy.ts",
    "destroy": "tsx aws-blocks/scripts/destroy.ts",
    "amplify:sandbox": "cross-env NODE_OPTIONS=\"--conditions=cdk\" AMPLIFY_SANDBOX=true npx ampx sandbox",
    "amplify:sandbox:delete": "cross-env NODE_OPTIONS=\"--conditions=cdk\" AMPLIFY_SANDBOX=true npx ampx sandbox delete --yes",
    "blocks:client": "cross-env NODE_OPTIONS=\"--conditions=aws-runtime\" tsx scripts/generate-blocks-client.ts",
    "build:amplify": "npm run blocks:client && npm run build && tsx scripts/amplify-blocks-config.ts",
    "test:e2e": "cross-env BUYER_SELF_SIGNUP=true tsx -C browser test/e2e.test.ts",
    "vendorize": "blocks-vendorize",
    "test": "vitest run aws-blocks src amplify scripts"
  },
  "dependencies": {
    "@aws-blocks/blocks": "~0.3.1",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@picocss/pico": "^2.1.1",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1144.0",
    "@aws-sdk/client-bedrock-agentcore-control": "^3.1144.0",
    "@aws-sdk/client-iam": "^3.1144.0",
    "@aws-sdk/client-sts": "^3.1144.0",
    "@coinbase/cdp-sdk": "^1.57.1",
    "@types/node": "^20.19.43",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.7",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "blocksTemplateVersion": "0.1.0"
}
