# AgentCore Payments セットアップ用（scripts/payments-setup.ts が読む）。
# 実物は .env に置く（gitignore 済み。コミットしないこと）

# ウォレットに紐づけるメールアドレス（PaymentInstrument の linkedAccounts）
PAYMENTS_LINK_EMAIL=

# --- Coinbase コネクタを MANUAL で作る場合（決定27 変更後の経路） ---
# CDP ポータル（https://portal.cdp.coinbase.com/）で発行する3点
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
