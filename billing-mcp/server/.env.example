# billing-mcp サーバー（売り手）
# 売上の受取先ウォレットアドレス（任意の EVM アドレス）
PAY_TO_ADDRESS=0x...
# x402 facilitator（テストネットは既定値のままでよい）
FACILITATOR_URL=https://x402.org/facilitator
# 価格（省略時 $0.1）
# PRICE=$0.1
# ポート（省略時 8000）
# PORT=8000
# 価格帯の判定に Jev を使う場合の API キー（決定58）。ローカルではこちらが優先され、
# クラウドでは Secrets Manager から読む。判定モデルそのものは AppConfig の価格表で切り替える
# TYPESAFE_API_KEY=
# ui:// で配信する HTML の場所（省略時は vite build の出力を読む。
# Lambda では CDK が zip 内のパスを注入するため、ローカルでは通常不要）
# UI_HTML_PATH=

# 買い手テストスクリプト（scripts/buy-once.ts）
# 使い捨てウォレットの秘密鍵（pnpm buy:once が未設定時に生成して表示する）
BUYER_PRIVATE_KEY=0x...
# MCP_SERVER_URL=http://localhost:8000/mcp
